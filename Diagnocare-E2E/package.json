{
  "name": "diagnocare-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Operator-workflow tests for DiagnoCare: receptionist, lab technician and doctor, driven through the real UI against a stateful mock API.",
  "scripts": {
    "test":              "node --test --test-concurrency=1 --test-timeout=240000 \"specs/*.e2e.test.js\"",
    "test:receptionist": "node --test --test-timeout=240000 specs/receptionist.e2e.test.js",
    "test:technician":   "node --test --test-timeout=240000 specs/lab-technician.e2e.test.js",
    "test:doctor":       "node --test --test-timeout=240000 specs/doctor.e2e.test.js"
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
