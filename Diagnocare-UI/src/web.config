<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!--
      Redirect all 404s back to index.html so Angular's client-side router
      can handle the URL.  This does NOT require the URL Rewrite IIS module.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!--
      Source maps are emitted for UAT ("hidden" maps: not referenced from the
      shipped bundles) and ship inside the deploy package.  Deny .map over HTTP
      so the original TypeScript is not downloadable from the site; developers
      take the maps from the Azure DevOps build artifact instead.
    -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>?
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- Ensure Angular's JSON chunks are served correctly -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

  </system.webServer>
</configuration>
