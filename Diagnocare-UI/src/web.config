<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!--
      Redirect all 404s back to index.html so Angular's client-side router
      can handle the URL.  This does NOT require the URL Rewrite IIS module.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!--
      Source maps are emitted for UAT ("hidden" maps: not referenced from the
      shipped bundles) and ship inside the deploy package.  Deny .map over HTTP
      so the original TypeScript is not downloadable from the site; developers
      take the maps from the Azure DevOps build artifact instead.
    -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <!-- Ensure Angular's JSON chunks are served correctly -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

  </system.webServer>
</configuration>
